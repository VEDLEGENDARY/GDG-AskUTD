# API provider: ollama, openai_compat, or extractive
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
USE_STUBS=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_PATH=backend/storage/askutd.db
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Optional directory for mounting a separately built UI later. Unset by default.
SERVE_UI_DIR=
