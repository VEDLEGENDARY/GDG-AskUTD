FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY app app
COPY components components
COPY lib lib
COPY public public
COPY next.config.ts tsconfig.json next-env.d.ts postcss.config.mjs tailwind.config.ts ./
ENV API_BASE_URL=http://api:8000 NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production API_BASE_URL=http://api:8000 NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
